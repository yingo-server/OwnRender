{
  "prog": "agnes-render",
  "version": "10.0.0",
  "source_of_truth": [
    "frame_interact/cli.py",
    "config.py"
  ],
  "generated_by": "tools/gen_cli_doc.py",
  "modes": [
    {
      "key": "tui",
      "desc": "无参数交互式界面",
      "cmd": "agnes-render",
      "notes": "有 TTY 时进入 TUI；非 TTY 自动退化打印 --help"
    },
    {
      "key": "ai",
      "desc": "云端生成底图 + 叠字",
      "cmd": "agnes-render --ai -t \"...\" -y",
      "notes": "需要 token；产出 raw 底图与 final 成图"
    },
    {
      "key": "offline",
      "desc": "内置底图 + 真实光照计算 + 叠字",
      "cmd": "agnes-render --offline-bg 微水泥 -t \"...\" -y",
      "notes": "全程离线，最常用；物理光照可按时间/坐标/天气调整"
    },
    {
      "key": "custom",
      "desc": "自有图片 + 光照 + 叠字",
      "cmd": "agnes-render -i in.png -t \"...\" -y",
      "notes": "不做 AI 生成，Pillow 读入后走同一条渲染链"
    }
  ],
  "env": [
    {
      "name": "OWNRENDER_HOME",
      "semantics": "便携根目录：优先用它定位 background/ fonts/ config/ output/。设为某目录后，素材/配置/输出都跟随它。",
      "example": "OWNRENDER_HOME=/sdcard/ow ./ownrender -y"
    },
    {
      "name": "OWNRENDER_ASCII",
      "semantics": "强制用 ASCII 符号渲染终端输出（无 Unicode 的终端/日志）。",
      "example": "OWNRENDER_ASCII=1"
    },
    {
      "name": "OWNRENDER_UNICODE",
      "semantics": "强制 Unicode（覆盖自动探测）。",
      "example": "OWNRENDER_UNICODE=1"
    },
    {
      "name": "OWNRENDER_NO_REEXEC",
      "semantics": "禁止自我重启（打包/验收环境用，避免进程被替换）。",
      "example": "OWNRENDER_NO_REEXEC=1"
    },
    {
      "name": "NO_COLOR",
      "semantics": "任何非空值＝关闭 ANSI 颜色（与 --no-color 等价）。",
      "example": "NO_COLOR=1"
    },
    {
      "name": "FORCE_COLOR",
      "semantics": "强制开启颜色（覆盖自动探测）。",
      "example": "FORCE_COLOR=1"
    },
    {
      "name": "AGNES_API_TOKEN",
      "semantics": "AI 模式令牌的环境变量形式（优先级低于 --token 之外，见 config）。",
      "example": "AGNES_API_TOKEN=xxx"
    },
    {
      "name": "TZ",
      "semantics": "时区；影响默认时间与太阳位置推算（POSIX 名优先）。",
      "example": "TZ=Asia/Shanghai"
    },
    {
      "name": "XDG_CONFIG_HOME",
      "semantics": "配置目录（安装目录只读时，配置落到 $XDG_CONFIG_HOME/ownrender）。",
      "example": "XDG_CONFIG_HOME=/tmp/cfg"
    },
    {
      "name": "LC_ALL / LANG / LANGUAGE",
      "semantics": "影响终端编码探测与提示语言选择；哑终端下 LC_ALL=C 也能正常出图（已验证）。",
      "example": "LC_ALL=C"
    }
  ],
  "exit_codes": [
    {
      "code": "0",
      "meaning": "成功（含 --dry-run / --no-render / 只读查询 / --set-location）"
    },
    {
      "code": "1",
      "meaning": "运行期错误：缺 token、底图/图片/字体不存在、定位失败、叠字失败、参数格式错"
    },
    {
      "code": "2",
      "meaning": "用法错误：未知参数、choices 越界（argparse 打印帮助并退出）"
    },
    {
      "code": "130",
      "meaning": "用户中断（Ctrl-C / TUI 里取消）"
    }
  ],
