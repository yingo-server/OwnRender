  "recipes": [
    {
      "desc": "最小可用（离线，无需网络/坐标）",
      "cmd": "agnes-render --offline-bg 微水泥 -t \"字\" -y --no-color"
    },
    {
      "desc": "确定性输出路径（推荐给自动化）",
      "cmd": "agnes-render --offline-bg 微水泥 -t \"字\" -o /tmp/out --output-name cover -y --no-color"
    },
    {
      "desc": "指定时间 + 坐标 + 天气（物理光照最准）",
      "cmd": "agnes-render --offline-bg 微水泥 --time \"2024-06-21 12:00\" --lat 39.9042 --lon 116.4074 --weather clear -t \"字\" -y"
    },
    {
      "desc": "固定随机种子做可复现实验",
      "cmd": "agnes-render --offline-bg 微水泥 --seed 12345 --ssaa 1 -t \"字\" -y"
    },
    {
      "desc": "只出光照底图（中间产物）",
      "cmd": "agnes-render --offline-bg 微水泥 --keep-lit --no-render -y"
    },
    {
      "desc": "列出可用资源（机器可解析）",
      "cmd": "agnes-render --list-fonts --list-backgrounds --no-color"
    },
    {
      "desc": "写定位缓存，后续 --gps 一键用",
      "cmd": "agnes-render --set-location \"39.9042,116.4074,北京\""
    },
    {
      "desc": "CI/容器里跑（无 TTY、无 locale）",
      "cmd": "LC_ALL=C NO_COLOR=1 agnes-render --offline-bg 微水泥 -t \"字\" -y --no-color"
    },
    {
      "desc": "Android/Termux 嵌入调用",
      "cmd": "agnes-render --offline-bg 微水泥 -o /sdcard/Pictures -y --no-color   # 坐标用 --lat/--lon 或 --set-location"
    }
  ],
  "failure_map": [
    {
      "symptom": "exit=2 且没有输出",
      "cause": "参数名拼错 / choices 越界",
      "fix": "agnes-render --help；或核对本文档的取值列"
    },
    {
      "symptom": "提示「未在 background/ 找到底图」",
      "cause": "底图名不对或素材目录不在便携根",
      "fix": "agnes-render --list-backgrounds；必要时设 OWNRENDER_HOME"
    },
    {
      "symptom": "「需要 --token 或配置」",
      "cause": "--ai 模式没给令牌",
      "fix": "--token 或 export AGNES_API_TOKEN，或改用 --offline-bg / -i"
    },
    {
      "symptom": "「位置解析失败」",
      "cause": "定位链全失败（无 GPS、无网、无坐标）",
      "fix": "直接 --lat/--lon，或先 --set-location 写缓存"
    },
    {
      "symptom": "等很久没有输出",
      "cause": "非交互环境里在等确认",
      "fix": "加 -y"
    },
    {
      "symptom": "颜色转义污染日志",
      "cause": "ANSI 颜色",
      "fix": "--no-color 或 NO_COLOR=1"
    },
    {
      "symptom": "容器里中文报编码错",
      "cause": "locale 不是 UTF-8",
      "fix": "LC_ALL=C 也能跑（已验证）；或设 PYTHONUTF8=1"
    },
    {
      "symptom": "ImportError: libblas/libgfortran/libjpeg...",
      "cause": "下载的二进制包缺系统库（打包问题）",
      "fix": "重新下载最新 Release；打包脚本会用 DT_NEEDED 自动补系统库"
    }
  ]
}
